diff --git a/cosmic-applet-notifications/src/refined_center.rs b/cosmic-applet-notifications/src/refined_center.rs
new file mode 100644
--- /dev/null
+++ b/cosmic-applet-notifications/src/refined_center.rs
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Notification-local rendering: retain the applet's state and message handlers.
+use cosmic::{
+    Element,
+    iced::{Alignment, Background, Border, Color, Length},
+    widget::{button, icon, text},
+};
+
+/// The collapsed first card expands its app group; expanded cards activate.
+/// Keep all dismissal buttons embedded in the supplied notification contents.
+#[allow(clippy::too_many_arguments)]
+pub fn group<'a, Message: Clone + 'static, F, G>(
+    critical: Vec<bool>,
+    elements: Vec<Element<'a, Message>>,
+    clear: Message,
+    toggle: Option<F>,
+    activate: Option<G>,
+    more: &'a str,
+    less: &'a str,
+    clear_label: &'a str,
+    app_icon: Option<icon::Handle>,
+    expanded: bool,
+) -> Element<'a, Message>
+where
+    F: Fn(bool) -> Message + 'a,
+    G: Fn(usize) -> Message + 'a,
+{
+    let multiple = elements.len() > 1;
+    let mut result = cosmic::widget::Column::new().spacing(8).width(Length::Fill);
+    if multiple && expanded {
+        let mut header = cosmic::widget::Row::new()
+            .spacing(8)
+            .align_y(Alignment::Center);
+        if let Some(handle) = app_icon {
+            header = header.push(icon::icon(handle).size(24));
+        }
+        header = header
+            .push(button::text(less).on_press_maybe(toggle.as_ref().map(|f| f(false))))
+            .push(button::text(clear_label).on_press(clear));
+        result = result.push(header);
+    }
+    for (i, element) in elements.into_iter().enumerate() {
+        if !expanded && i > 0 {
+            break;
+        }
+        let mut content = cosmic::widget::Column::new()
+            .push(element)
+            .spacing(8)
+            .width(Length::Fill);
+        if multiple && !expanded {
+            content = content.push(text::caption(more));
+        }
+        let message = if multiple && !expanded {
+            toggle.as_ref().map(|f| f(true))
+        } else {
+            activate.as_ref().map(|f| f(i))
+        };
+        let accented = critical.get(i).copied().unwrap_or(false);
+        result = result.push(
+            cosmic::iced::widget::button(content)
+                .on_press_maybe(message)
+                .padding(16)
+                .width(Length::Fill)
+                .class(cosmic::theme::iced::Button::Custom(Box::new(
+                    move |theme, status| {
+                        use cosmic::iced::widget::button::{Status, Style};
+                        let dark = theme.cosmic().is_dark;
+                        let (surface, foreground, neutral) = if dark {
+                            let background = match status {
+                                Status::Hovered => [0.15, 0.16, 0.18],
+                                Status::Pressed => [0.19, 0.20, 0.22],
+                                _ => [0.10, 0.11, 0.13],
+                            };
+                            (background, [0.97; 3], [0.55; 3])
+                        } else {
+                            let background = match status {
+                                Status::Hovered => [0.92; 3],
+                                Status::Pressed => [0.87; 3],
+                                _ => [0.98; 3],
+                            };
+                            (background, [0.08, 0.09, 0.11], [0.40; 3])
+                        };
+                        let boundary = if accented {
+                            if dark {
+                                [1.0, 0.65, 0.25]
+                            } else {
+                                [0.55, 0.24, 0.0]
+                            }
+                        } else {
+                            neutral
+                        };
+                        let color = |v: [f32; 3]| Color::from_rgb(v[0], v[1], v[2]);
+                        Style {
+                            background: Some(Background::Color(color(surface))),
+                            text_color: color(foreground),
+                            border: Border {
+                                color: color(boundary),
+                                width: if accented { 2.0 } else { 1.0 },
+                                radius: 18.0.into(),
+                            },
+                            border_radius: 18.0.into(),
+                            ..Default::default()
+                        }
+                    },
+                ))),
+        );
+    }
+    cosmic::widget::container(result)
+        .max_width(380)
+        .width(Length::Fill)
+        .into()
+}
