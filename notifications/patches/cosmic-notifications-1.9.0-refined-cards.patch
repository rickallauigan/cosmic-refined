+// SPDX-License-Identifier: GPL-3.0-only
+// COSMIC Refined notification-local policy; no COSMIC configuration writes.
+use std::time::{SystemTime, UNIX_EPOCH};
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Options {
+    pub enabled: bool,
+    pub urgency_accent: bool,
+}
+
+impl Options {
+    pub fn from_env() -> Self {
+        Self::parse(
+            std::env::var("COSMIC_REFINED_NOTIFICATION_CARDS")
+                .ok()
+                .as_deref(),
+            std::env::var("COSMIC_REFINED_NOTIFICATION_URGENCY")
+                .ok()
+                .as_deref(),
+        )
+    }
+
+    fn parse(enabled: Option<&str>, accent: Option<&str>) -> Self {
+        Self {
+            enabled: enabled == Some("1"),
+            urgency_accent: accent == Some("1"),
+        }
+    }
+
+    pub fn width(self) -> u32 {
+        if self.enabled { 380 } else { 300 }
+    }
+
+    pub fn radius(self, stock: [f32; 4]) -> [f32; 4] {
+        if self.enabled { [18.0; 4] } else { stock }
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct Palette {
+    pub surface: [f32; 3],
+    pub hover: [f32; 3],
+    pub pressed: [f32; 3],
+    pub text: [f32; 3],
+    pub border: [f32; 3],
+}
+
+pub fn palette(dark: bool, critical_accent: bool) -> Palette {
+    let mut result = if dark {
+        Palette {
+            surface: [0.10, 0.11, 0.13],
+            hover: [0.15, 0.16, 0.18],
+            pressed: [0.19, 0.20, 0.22],
+            text: [0.97; 3],
+            border: [0.55; 3],
+        }
+    } else {
+        Palette {
+            surface: [0.98; 3],
+            hover: [0.92; 3],
+            pressed: [0.87; 3],
+            text: [0.08, 0.09, 0.11],
+            border: [0.40; 3],
+        }
+    };
+    if critical_accent {
+        result.border = if dark {
+            [1.0, 0.65, 0.25]
+        } else {
+            [0.55, 0.24, 0.0]
+        };
+    }
+    result
+}
+
+// Absolute receipt time, not elapsed time: no timer or per-frame clock reads.
+// Explicit UTC avoids introducing a timezone crate or invoking a shell command.
+pub fn timestamp(time: SystemTime) -> String {
+    match time.duration_since(UNIX_EPOCH) {
+        Ok(duration) => {
+            let minutes = duration.as_secs() / 60;
+            format!("{:02}:{:02} UTC", (minutes / 60) % 24, minutes % 60)
+        }
+        Err(_) => String::from("Time unavailable"),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::time::Duration;
+
+    #[test]
+    fn opt_in_is_explicit_and_preserves_stock_geometry() {
+        for value in [None, Some("0"), Some("true"), Some(""), Some("yes")] {
+            let options = Options::parse(value, None);
+            assert!(!options.enabled);
+            assert!(!options.urgency_accent);
+            assert_eq!(options.width(), 300);
+            assert_eq!(options.radius([2.0; 4]), [2.0; 4]);
+        }
+        let options = Options::parse(Some("1"), Some("1"));
+        assert!(options.enabled && options.urgency_accent);
+        assert_eq!(options.width(), 380);
+        assert_eq!(options.radius([2.0; 4]), [18.0; 4]);
+    }
+
+    #[test]
+    fn receipt_time_is_deterministic_and_handles_day_rollover() {
+        assert_eq!(timestamp(UNIX_EPOCH), "00:00 UTC");
+        assert_eq!(
+            timestamp(UNIX_EPOCH + Duration::from_secs(86399)),
+            "23:59 UTC"
+        );
+        assert_eq!(
+            timestamp(UNIX_EPOCH + Duration::from_secs(86400)),
+            "00:00 UTC"
+        );
+        assert_eq!(
+            timestamp(UNIX_EPOCH - Duration::from_secs(1)),
+            "Time unavailable"
+        );
+    }
+
+    fn luminance(rgb: [f32; 3]) -> f32 {
+        let linear = rgb.map(|v| {
+            if v <= 0.04045 {
+                v / 12.92
+            } else {
+                ((v + 0.055) / 1.055).powf(2.4)
+            }
+        });
+        linear[0] * 0.2126 + linear[1] * 0.7152 + linear[2] * 0.0722
+    }
+
+    fn contrast(a: [f32; 3], b: [f32; 3]) -> f32 {
+        let (a, b) = (luminance(a), luminance(b));
+        (a.max(b) + 0.05) / (a.min(b) + 0.05)
+    }
+
+    #[test]
+    fn text_and_boundaries_have_contrast_in_all_interaction_states() {
+        for dark in [false, true] {
+            for accent in [false, true] {
+                let colors = palette(dark, accent);
+                for surface in [colors.surface, colors.hover, colors.pressed] {
+                    assert!(contrast(colors.text, surface) >= 7.0);
+                    assert!(contrast(colors.border, surface) >= 3.0);
+                }
+            }
+        }
+    }
+}
